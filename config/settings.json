{
	"main-settings": {
		"label": "Twitch Milestone Tracker",
		"settings": {
			"widget-desc": {
				"type": "text-display",
				"label": "This is a milestone tracker Twitch, set up to work with the Twitch Dono Clock (https://github.com/Latent-Logic/twitch-dono-clock)\n\nIt will display a list of milestones you provide, letting you style and position it however you like! Previously hit milestones and the current milestone can be styled differently. The overlay will update according to the latest total amount raised."
			},
			"websocket-settings": {
				"type": "section",
				"label": "Websocket",
				"settings": {
					"wss-url": {
						"type": "text-input",
						"label": "Websocket URL",
						"condition": {},
						"placeholder": "wss://",
						"description": "Target address for the websocket listener. This will establish a websocket connection that'll update whenever a donation event is received from the bot server."
					},
					"server-connect": {
						"type": "toggle-input",
						"label": "Connect to server",
						"halfSpan": true,
						"defaultValue": false,
						"description": "Toggles whether to try to connect to the websocket. If false, you'll be able to set an placeholder amount for testing."
					},
					"test-amount-val": {
						"type": "number-input",
						"label": "Placeholder amount",
						"condition": {},
						"halfSpan": true,
						"defaultValue": 500,
						"min": 0,
						"placeholder": "$ amount",
						"description": "Uses this as the current amount raised when the server is not connected"
					},
					"ws-reconnect": {
						"type": "button",
						"label": "Reconnect"
					},
					"server-info": {
						"type": "text-display",
						"label": "This will try to establish a websocket connection when the page first loads, but shouldn't keep trying whenever you change you change values. If you aren't seeing the amount value update, Inspect page in your browser to see if there are connection issues"
					}
				}
			}
		}
	},
	"milestone-settings": {
		"label": "Milestones",
		"settings": {
			"milestone-list": {
				"type": "text-area-input",
				"label": "Milestone List",
				"condition": {},
				"defaultValue": "500, milestone",
				"placeholder": "number, text",
				"description": "List of milestones, formatted as [number, text].\nexample: 500, eat a pickle"
			},
			"milestone-table-settings": {
				"type": "section",
				"label": "Table Settings",
				"settings": {
					"n-prev-milestones": {
						"type": "number-input",
						"label": "Show N Previous Milestones",
						"halfSpan": true,
						"defaultValue": 5,
						"min": 0
					},
					"n-next-milestones": {
						"type": "number-input",
						"label": "Show N Next Milestones",
						"halfSpan": true,
						"defaultValue": 1,
						"min": 0
					},
					"table-margin-top": {
						"type": "slider-input",
						"label": "Top Margin",
						"halfSpan": true,
						"defaultValue": 0,
						"min": 0,
						"max": 100,
						"step": 1
					},
					"table-margin-left": {
						"type": "slider-input",
						"label": "Left Margin",
						"halfSpan": true,
						"defaultValue": 0,
						"min": 0,
						"max": 100,
						"step": 1
					},
					"table-y-spacing": {
						"type": "slider-input",
						"label": "Row Spacing",
						"defaultValue": 0,
						"min": 0,
						"max": 100,
						"step": 1
					}
				}
			}
		}
	},
